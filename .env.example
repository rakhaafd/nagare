# Discord Webhook Configuration (diperlukan jika menjalankan live notification ke Discord)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# GitHub Webhook Secret (opsional, untuk verifikasi HMAC signature)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Server Port (opsional, jika membuat HTTP webhook listener)
PORT=3000
